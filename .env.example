# Copy this file to .env and replace the value with your demo authority password.
# Do not upload .env to GitHub or share it publicly.
PILAR360_ADMIN_PASSWORD=change-this-demo-password

# Required only if you want to accept optional contact numbers. Generate a private random value.
# Keep this key safe and unchanged or existing encrypted phone numbers cannot be read.
# PILAR360_PHONE_ENCRYPTION_KEY=

# Optional SMS notifications through Semaphore. Keep the API key private.
# An SMS account, available credits and a registered/default sender name may be required.
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDERNAME=
